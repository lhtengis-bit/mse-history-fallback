{
  "name": "mse-history-fallback",
  "version": "1.0.0",
  "private": true,
  "description": "Fills _securitytradingstatus_history from MSE's live datafeed when the server-side feed missed rows; runs on an MSE-allowlisted machine",
  "main": "src/run.js",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "test": "node test/run-all.js",
    "start": "node src/run.js",
    "dry-run": "node src/run.js --dry-run",
    "backfill": "node src/backfill.js"
  },
  "dependencies": {
    "axios": "^1.13.2",
    "dotenv": "^8.2.0",
    "moment-timezone": "^0.5.48",
    "mysql2": "^3.15.3",
    "nodemailer": "^6.4.17",
    "sequelize": "^6.3.5",
    "ssh2": "^1.17.0"
  }
}

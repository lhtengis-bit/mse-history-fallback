# SSH tunnel to production, opened by the script on every run (like Workbench's "TCP/IP over SSH"). Leave SSH_HOST out to connect to DB_HOST directly.
# production's address (for example its Tailscale 100.68.x.x)
SSH_HOST=100.68.0.1
# SSH login on production
SSH_USERNAME=change-me
# SSH password
SSH_PASSWORD=change-me
# optional: SSH port (default 22)
#SSH_PORT=22
# optional: MySQL's port on production (default 3306)
#SSH_REMOTE_PORT=3306
# with the tunnel: 127.0.0.1 and a free local port; without it: MySQL's own host and port
DB_HOST=127.0.0.1
DB_PORT=13306
# least-privilege user: SELECT, INSERT, UPDATE on _securitytradingstatus_history only
DB_USERNAME=mse_fallback
# password of that user
DB_PASSWORD=change-me
# database name (same as production's)
DB_DATABASE=changeme_db
# must match production: rows are stamped with Ulaanbaatar dates
DB_TIMEZONE=+08:00
# MSE datafeed login
MSE_API_USER=change-me
# MSE datafeed password
MSE_API_PASS=change-me
# optional: MSE datafeed base URL (default https://tradingapi.mse.mn/api)
#MSE_API_BASE=https://tradingapi.mse.mn/api
# optional: MSE request timeout in ms (default 60000)
#MSE_API_TIMEOUT_MS=60000
# SMTP relay used for the alert mail
SMTP_HOST=smtp.example.com
# SMTP port
SMTP_PORT=587
# SMTP login
SMTP_USER=alerts@example.com
# SMTP password
SMTP_PASS=change-me
# display name in the From header
SMTP_FROM=MSE fallback
# address in the From header
SMTP_FROM_EMAIL=alerts@example.com
# who gets the alert mail (default it@bdsec.mn)
MSE_FALLBACK_ALERT_EMAIL=it@bdsec.mn
